    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
